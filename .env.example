# Copia este archivo a .env y llena los valores reales.
# NUNCA subas .env a git (ya esta en .gitignore).

# OAuth2 con Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Email que se activa automaticamente como ADMIN al primer arranque
ADMIN_SEED_EMAIL=tu-correo@gmail.com

# URL publica de la app (usada para las redirecciones de Stripe)
APP_BASE_URL=http://localhost:8080
